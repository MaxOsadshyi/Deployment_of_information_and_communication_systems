# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  # ==========================================
  # Перша віртуальна машина: Ubuntu
  # ==========================================
  config.vm.define "web-server" do |web|
    web.vm.box = "ubuntu/jammy64"
    web.vm.hostname = "web-server"

    # Ресурси VirtualBox (2 CPU, 2048 MB RAM)
    web.vm.provider "virtualbox" do |vb|
      vb.name = "Ubuntu_Web_Server"
      vb.cpus = 2
      vb.memory = 2048
    end
  end

  # ==========================================
  # Друга віртуальна машина: Debian
  # ==========================================
  config.vm.define "db-server" do |db|
    db.vm.box = "debian/bookworm64"
    db.vm.hostname = "db-server"

    # Ресурси VirtualBox (1 CPU, 1024 MB RAM)
    db.vm.provider "virtualbox" do |vb|
      vb.name = "Debian_DB_Server"
      vb.cpus = 1
      vb.memory = 1024
    end
  end

end